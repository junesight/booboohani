# 실제 비밀값을 입력하지 마세요.
# 저장소에서 사용하는 환경변수 이름만 기록합니다.

PUBLIC_SITE_URL=https://booboo.co.kr

# 아래는 실제 프로젝트에서 필요할 때만 활성화하세요.
# NOTION_TOKEN=
# NOTION_DATABASE_ID=
# PUBLIC_GA_MEASUREMENT_ID=
# PUBLIC_NAVER_SITE_VERIFICATION=
# PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional local preview settings. Pass these to the command explicitly.
# Production reads the public project settings from health-config.json.
HEALTH_CONTENT_SOURCE=sanity
PORT=8768
# No Sanity write token or GitHub personal access token is needed by the site build.
